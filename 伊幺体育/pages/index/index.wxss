.index-page {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.swiper-container {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 120%;
  overflow: hidden;
  background: #eef5e8;
}

.top-swiper,
.swiper-item,
.swiper-background,
.swiper-background-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.swiper-background {
  z-index: 0;
}

.swiper-background-img {
  transition: opacity 0.5s linear;
}

.swiper-imgs {
  width: 100%;
  height: 100%;
}

.top-swiper {
  z-index: 1;
}

.swiper-item {
  display: flex;
  align-items: center;
  justify-content: center;
}

.swiper-item-loading {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(245, 247, 248, 0.32);
}

.main-container {
  position: relative;
  z-index: 3;
  margin-top: -86rpx;
}

.user-section {
  margin-top: 0;
}

.user-card {
  display: flex;
  align-items: center;
  min-height: 132rpx;
  padding: 24rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  margin-right: 18rpx;
  border-radius: 50%;
}

.user-main {
  flex: 1;
  min-width: 0;
}

.user-row {
  display: flex;
  align-items: center;
}

.level {
  margin-right: 12rpx;
  padding: 4rpx 12rpx;
  color: #ffffff;
  font-size: 20rpx;
  border-radius: 18rpx;
  background: #12a86b;
}

.name {
  max-width: 250rpx;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.progress-wrap {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.progress-wrap progress {
  width: 220rpx;
}

.exp {
  margin-left: 10rpx;
  color: #7f8b99;
  font-size: 20rpx;
}

.asset {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 76rpx;
  color: #7f8b99;
  font-size: 20rpx;
}

.asset-num {
  margin-top: 6rpx;
  color: #f08b16;
  font-size: 30rpx;
  font-weight: 800;
}

.entry-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.entry-card {
  position: relative;
  min-height: 260rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(25, 43, 64, 0.07);
}

.tap {
  transform: scale(0.98);
  opacity: 0.88;
}

.entry-img {
  position: absolute;
  right: -12rpx;
  bottom: 8rpx;
  width: 200rpx;
  height: 200rpx;
  opacity: 0.9;
}

.entry-copy {
  position: relative;
  z-index: 1;
  padding: 28rpx 24rpx;
}

.entry-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
}

.entry-desc {
  display: block;
  width: 210rpx;
  margin-top: 10rpx;
  color: #7f8b99;
  font-size: 22rpx;
  line-height: 1.45;
}

.walk {
  background: linear-gradient(180deg, #ffffff 0%, #ecfbf4 100%);
}

.reserve {
  background: linear-gradient(180deg, #ffffff 0%, #eef7ff 100%);
}

.venue-scroll {
  width: 100%;
  white-space: nowrap;
}

.venue-card {
  display: inline-block;
  width: 280rpx;
  margin-right: 18rpx;
  padding: 16rpx;
  vertical-align: top;
}

.venue-img {
  width: 100%;
  height: 160rpx;
  border-radius: 12rpx;
}

.venue-name,
.activity-title {
  display: block;
  margin-top: 14rpx;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.venue-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.venue-sub,
.activity-desc,
.activity-time {
  display: block;
  margin-top: 10rpx;
  color: #7f8b99;
  font-size: 22rpx;
}

.activity-card {
  display: flex;
  padding: 18rpx;
  margin-bottom: 18rpx;
}

.activity-img {
  width: 190rpx;
  height: 138rpx;
  margin-right: 20rpx;
  border-radius: 12rpx;
}

.activity-body {
  flex: 1;
  min-width: 0;
}
