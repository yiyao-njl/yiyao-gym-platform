.profile-edit-page {
  background: #f6f6f6;
}

.edit-card {
  position: relative;
  margin: calc(238rpx + env(safe-area-inset-top)) 24rpx 0;
  padding: 148rpx 28rpx 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.avatar-wrap {
  position: absolute;
  left: 50%;
  top: -72rpx;
  width: 148rpx;
  height: 148rpx;
  transform: translateX(-50%);
}

.edit-avatar {
  width: 148rpx;
  height: 148rpx;
  border: 8rpx solid #fff6dc;
  border-radius: 50%;
  background: #ffe4a8;
}

.camera-dot {
  position: absolute;
  right: -4rpx;
  bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  font-size: 22rpx;
  border-radius: 50%;
  background: #c8aa67;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.label {
  width: 112rpx;
  color: #444444;
  font-size: 30rpx;
}

.field {
  flex: 1;
  min-width: 0;
  color: #111111;
  font-size: 30rpx;
}

.text-field {
  line-height: 108rpx;
}

.edit-icon,
.action-text {
  color: #9a9a9a;
  font-size: 26rpx;
}

.gender-group {
  display: flex;
  gap: 44rpx;
  align-items: center;
}

.gender-group label {
  color: #111111;
  font-size: 30rpx;
}

.birthday-tip {
  flex: 1;
  color: #9a9a9a;
  font-size: 28rpx;
}

.birthday-btn {
  width: 144rpx;
  height: 56rpx;
  color: #333333;
  font-size: 26rpx;
  line-height: 56rpx;
  text-align: center;
  border: 1rpx solid #dddddd;
  border-radius: 8rpx;
}

.minor-tip {
  display: block;
  margin-top: 18rpx;
  color: #999999;
  font-size: 24rpx;
  line-height: 36rpx;
}

.switch-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 108rpx;
  margin: 24rpx;
  padding: 0 28rpx;
  color: #222222;
  font-size: 30rpx;
  border-radius: 18rpx;
  background: #ffffff;
}

.switch-card text:last-child {
  color: #b5b5b5;
  font-size: 44rpx;
}

.profile-save-bar {
  background: transparent;
  box-shadow: none;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  color: #f1d28c;
  font-size: 32rpx;
  line-height: 88rpx;
  border-radius: 48rpx;
  background: #4a4a4a;
}
