.city-page {
  background: #ffffff;
}

.city-scroll {
  height: calc(100vh - 188rpx);
  background: #ffffff;
}

.city-section {
  padding: 42rpx 72rpx 22rpx 30rpx;
}

.hot-section {
  padding-top: 46rpx;
}

.city-label {
  display: block;
  margin-bottom: 26rpx;
  color: #777777;
  font-size: 28rpx;
  line-height: 40rpx;
}

.locate-chip {
  display: inline-flex;
  align-items: center;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  color: #222222;
  font-size: 32rpx;
  background: #f7f7f7;
}

.locate-chip.success {
  color: #111111;
}

.locate-dot {
  position: relative;
  width: 26rpx;
  height: 26rpx;
  margin-right: 18rpx;
  border-radius: 50% 50% 50% 0;
  background: #c8a15a;
  transform: rotate(-45deg);
}

.locate-dot::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ffffff;
}

.city-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18rpx;
}

.city-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 14rpx;
  color: #111111;
  font-size: 30rpx;
  background: #f7f7f7;
}

.city-groups {
  padding: 72rpx 72rpx 40rpx 30rpx;
}

.city-group {
  margin-bottom: 16rpx;
}

.letter {
  display: block;
  height: 80rpx;
  color: #999999;
  font-size: 30rpx;
  line-height: 80rpx;
}

.city-row {
  height: 104rpx;
  color: #111111;
  font-size: 30rpx;
  line-height: 104rpx;
  background: #ffffff;
}

.letter-index {
  position: fixed;
  right: 18rpx;
  top: 582rpx;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
  width: 54rpx;
  color: #333333;
  font-size: 24rpx;
  line-height: 24rpx;
}

.letter-index .index-word {
  width: 48rpx;
  font-size: 24rpx;
  line-height: 28rpx;
  text-align: center;
}
