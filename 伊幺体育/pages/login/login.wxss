.login-page {
  min-height: 100vh;
  padding: calc(42rpx + env(safe-area-inset-top)) 32rpx 54rpx;
  box-sizing: border-box;
  color: #191f1c;
  background:
    linear-gradient(180deg, #eef7f1 0%, #f7f8f7 34%, #f7f8f7 100%);
}

.login-nav {
  display: flex;
  align-items: center;
  height: 72rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  margin: 0 18rpx 0 0;
  padding: 0 4rpx 6rpx 0;
  color: #171717;
  font-size: 54rpx;
  line-height: 54rpx;
  border: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 10rpx 24rpx rgba(20, 56, 38, 0.08);
}

.back-btn::after,
.avatar-field::after,
.phone-picker::after,
.submit-btn::after {
  border: 0;
}

.login-nav > text {
  color: #101514;
  font-size: 34rpx;
  font-weight: 800;
}

.login-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 54rpx 16rpx 38rpx;
  text-align: center;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 144rpx;
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 24rpx 52rpx rgba(29, 90, 62, 0.14);
}

.brand-mark image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
}

.headline {
  margin-top: 30rpx;
  color: #111111;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 62rpx;
}

.subhead {
  max-width: 560rpx;
  margin-top: 16rpx;
  color: #68736e;
  font-size: 27rpx;
  line-height: 42rpx;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  margin-top: 26rpx;
  padding: 0 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.74);
  box-shadow: inset 0 0 0 1rpx rgba(30, 70, 50, 0.05);
}

.status-row text {
  color: #64716b;
  font-size: 22rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #d5ded9;
}

.status-dot.is-on {
  background: #12a86b;
}

.status-line {
  width: 34rpx;
  height: 1rpx;
  margin: 0 12rpx;
  background: #dbe5df;
}

.profile-panel {
  overflow: hidden;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 22rpx 48rpx rgba(34, 63, 50, 0.08);
}

.panel-title {
  padding: 30rpx 30rpx 22rpx;
}

.panel-title text:first-child {
  display: block;
  color: #141817;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.panel-title text:last-child {
  display: block;
  margin-top: 8rpx;
  color: #8a948f;
  font-size: 23rpx;
  line-height: 34rpx;
}

.avatar-field,
.form-row,
.phone-row {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  margin: 0 30rpx;
  padding: 0;
  border-top: 1rpx solid #eef1ef;
}

.avatar-field {
  width: auto;
  text-align: left;
  border-radius: 0;
  background: transparent;
}

.avatar-preview {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  margin-right: 22rpx;
  color: #168a5b;
  font-size: 22rpx;
  line-height: 26rpx;
  border-radius: 50%;
  background: #e9f7ef;
}

.avatar-preview image {
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
}

.field-main {
  flex: 1;
  min-width: 0;
}

.field-main > text:first-child {
  display: block;
  color: #18201c;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.field-main > text:last-child {
  display: block;
  margin-top: 8rpx;
  color: #8b9690;
  font-size: 24rpx;
  line-height: 34rpx;
}

.field-main input {
  width: 100%;
  height: 46rpx;
  margin-top: 8rpx;
  color: #202624;
  font-size: 29rpx;
  line-height: 46rpx;
}

.field-arrow {
  margin-left: 18rpx;
  color: #b8c0bc;
  font-size: 48rpx;
}

.phone-row {
  min-height: 132rpx;
}

.phone-picker {
  flex-shrink: 0;
  width: 262rpx;
  height: 68rpx;
  margin: 0 0 0 22rpx;
  padding: 0;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 68rpx;
  border-radius: 36rpx;
  background: #13aa6b;
}

.phone-picker.is-ready {
  color: #0f8354;
  background: #e4f6ee;
}

.submit-btn {
  width: 450rpx;
  height: 92rpx;
  margin: 48rpx auto 0;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 92rpx;
  border-radius: 48rpx;
  background: #101010;
  box-shadow: 0 18rpx 34rpx rgba(0, 0, 0, 0.16);
}

.submit-btn[disabled] {
  color: rgba(255, 255, 255, 0.82);
  background: #777777;
  box-shadow: none;
}

.privacy-note {
  display: block;
  max-width: 560rpx;
  margin: 24rpx auto 0;
  color: #99a29d;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
}
