<view class="page logout-page">
  <view class="app-nav">
    <button class="app-nav-back" bindtap="goBack"></button>
    <text class="app-nav-title">退出登录</text>
  </view>

  <view class="logout-main">
    <view class="door-icon"></view>
    <text>退出后将无法使用完整功能哦</text>
    <button bindtap="showConfirm">退出登录</button>
  </view>

  <view wx:if="{{confirmVisible}}" class="logout-mask" catchtouchmove="noopTouchMove">
    <view class="logout-dialog">
      <text class="dialog-title">提示</text>
      <text class="dialog-content">确认退出当前账号吗？</text>
      <view class="dialog-actions">
        <button class="cancel" bindtap="hideConfirm">取消</button>
        <button class="confirm" bindtap="confirmLogout">确定</button>
      </view>
    </view>
  </view>
</view>
