<view class="page switch-page">
  <view class="app-nav">
    <button class="app-nav-back" bindtap="goBack"></button>
    <text class="app-nav-title">切换账号</text>
  </view>

  <view class="switch-main">
    <view class="phone-icon"></view>
    <text class="phone-title">当前登录手机号:{{maskedPhone}}</text>
    <text class="phone-desc">切换其他账号后，当前登录的账号将退出！新手机号若未注册，将自动注册为新账号</text>
    <button class="switch-btn" open-type="getPhoneNumber" bindgetphonenumber="onSwitchPhone">确认切换</button>
  </view>

  <button class="cancel-account" bindtap="goCancel">注销账号</button>
</view>
