.store-page {
  background: #f6f6f6;
  padding-bottom: 0;
}

.store-tabs {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  align-items: center;
  height: 96rpx;
  padding: 0 32rpx;
  background: #ffffff;
}

.store-tab {
  color: #777777;
  font-size: 34rpx;
  line-height: 96rpx;
  text-align: center;
}

.store-tab.active {
  color: #111111;
  font-weight: 500;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 76rpx;
  margin: 0 32rpx 22rpx;
  padding: 0 28rpx;
  border-radius: 8rpx;
  background: #f3f3f3;
}

.city-entry {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  color: #333333;
  font-size: 28rpx;
}

.down {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid #333333;
}

.divider {
  width: 1rpx;
  height: 40rpx;
  margin: 0 28rpx;
  background: #d7d7d7;
}

.search-box {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.search-box input {
  flex: 1;
  height: 70rpx;
  color: #222222;
  font-size: 28rpx;
}

.search-placeholder {
  color: #8b8b8b;
}

.search-icon {
  display: block;
  width: 34rpx;
  height: 34rpx;
  margin-right: 18rpx;
}

.map-wrap {
  position: relative;
  height: 432rpx;
  overflow: hidden;
  background: #e9ecec;
}

.store-map {
  width: 100%;
  height: 370rpx;
}

.map-locate {
  position: absolute;
  right: 24rpx;
  bottom: 82rpx;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.16);
}

.map-locate image {
  display: block;
  width: 44rpx;
  height: 44rpx;
  margin: 11rpx;
}

.map-collapse {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 62rpx;
  color: #9b9b9b;
  font-size: 26rpx;
  background: #ffffff;
}

.map-collapse text {
  width: 14rpx;
  height: 14rpx;
  margin-left: 14rpx;
  border-left: 4rpx solid #9b9b9b;
  border-top: 4rpx solid #9b9b9b;
  transform: rotate(45deg) translateY(4rpx);
}

.store-list {
  height: calc(100vh - 802rpx);
  padding: 0 18rpx calc(28rpx + env(safe-area-inset-bottom));
}

.current-city {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 86rpx;
  color: #444444;
  font-size: 30rpx;
}

.pin-small {
  display: block;
  width: 34rpx;
  height: 34rpx;
}

.store-card {
  position: relative;
  min-height: 268rpx;
  margin-bottom: 20rpx;
  padding: 34rpx 28rpx 28rpx;
  overflow: hidden;
  border: 2rpx solid transparent;
  border-radius: 8rpx;
  background: #ffffff;
}

.store-card.selected {
  border: 4rpx solid #4a4a4a;
}

.check-corner {
  position: absolute;
  right: 0;
  top: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 0 0 0 18rpx;
  background: #4a4a4a;
}

.check-corner text {
  display: block;
  color: #f4cf7a;
  font-size: 36rpx;
  line-height: 48rpx;
  text-align: center;
}

.store-title-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.star {
  flex-shrink: 0;
  width: 42rpx;
  height: 42rpx;
  margin-right: 16rpx;
}

.store-name {
  overflow: hidden;
  color: #222222;
  font-size: 34rpx;
  line-height: 48rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-address,
.store-hours {
  display: block;
  margin-top: 24rpx;
  overflow: hidden;
  color: #9a9a9a;
  font-size: 26rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 180rpx;
}

.store-hours {
  margin-top: 14rpx;
}

.store-meta {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.status-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 78rpx;
  height: 42rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.status-tag {
  color: #777777;
  border: 2rpx solid #b8b8b8;
  background: #ffffff;
}

.status-tag.open {
  color: #3b7f42;
  border-color: #9fd7a7;
  background: #f2fbf3;
}

.status-tag.resting {
  color: #8a8a8a;
  border-color: #d6d6d6;
  background: #ffffff;
}

.store-actions {
  position: absolute;
  right: 28rpx;
  bottom: 56rpx;
  display: flex;
  gap: 28rpx;
  align-items: center;
}

.round-action {
  position: relative;
  display: block;
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  border-radius: 18rpx;
  background: #f4f4f4;
}

.round-action image {
  display: block;
  width: 42rpx;
  height: 42rpx;
  margin: 11rpx;
}
