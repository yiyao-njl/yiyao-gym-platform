.open-page {
  min-height: 100vh;
  color: #20242a;
  background: #f6f6f6;
}

.fixed-open-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 120;
  padding: 0 28rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(24, 35, 45, 0.04);
}

.shop-tools,
.store-line,
.store-main,
.quick-row,
.venue-top,
.price-row,
.member-row {
  display: flex;
  align-items: center;
}

.shop-tools {
  gap: 14rpx;
  margin: 0 -28rpx;
  padding: 96rpx 28rpx 16rpx;
  background: #ffffff;
}

.seg {
  display: flex;
  flex: 0 0 auto;
  height: 68rpx;
  padding: 6rpx;
  border-radius: 36rpx;
  background: #f3f3f3;
}

.seg-item {
  min-width: 96rpx;
  height: 56rpx;
  color: #7f7f7f;
  font-size: 30rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 30rpx;
}

.seg-item.active {
  color: #ffffff;
  font-weight: 700;
  background: #3f3f3f;
}

.search {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
  height: 68rpx;
  padding: 0 24rpx;
  border-radius: 34rpx;
  background: #f7f7f7;
}

.search-icon {
  margin-right: 12rpx;
  color: #a6a6a6;
  font-size: 34rpx;
}

.search input {
  flex: 1;
  min-width: 0;
  color: #333333;
  font-size: 28rpx;
}

.mini-program-dot {
  display: none;
  width: 102rpx;
  height: 58rpx;
  color: #1d1d1d;
  font-size: 36rpx;
  line-height: 46rpx;
  text-align: center;
  border: 1rpx solid #eeeeee;
  border-radius: 32rpx;
  background: #ffffff;
}

.store-line {
  justify-content: space-between;
  min-height: 112rpx;
  padding-top: 22rpx;
}

.store-main {
  min-width: 0;
}

.store-star {
  margin-right: 14rpx;
  color: #ececec;
  font-size: 30rpx;
}

.store-name {
  display: block;
  max-width: 420rpx;
  overflow: hidden;
  color: #2d2d2d;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-address {
  display: block;
  max-width: 430rpx;
  margin-top: 6rpx;
  overflow: hidden;
  color: #8a8a8a;
  font-size: 22rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-distance {
  display: block;
  margin-top: 8rpx;
  color: #585858;
  font-size: 24rpx;
}

.store-arrow {
  margin-left: 10rpx;
  color: #363636;
  font-size: 46rpx;
  line-height: 40rpx;
}

.group-entry {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 0 0 auto;
  color: #7f6a38;
  font-size: 20rpx;
}

.group-icon {
  display: block;
  width: 64rpx;
  height: 52rpx;
  color: #d6af56;
  font-size: 42rpx;
  line-height: 52rpx;
  text-align: center;
}

.choose-store {
  width: 148rpx;
  height: 56rpx;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 56rpx;
  border-radius: 30rpx;
  background: #3f3f3f;
}

.benefit-line {
  display: flex;
  justify-content: space-between;
  margin: 18rpx -28rpx 0;
  padding: 18rpx 28rpx;
  color: #666666;
  font-size: 26rpx;
  background: #fbfbfb;
}

.benefit-more {
  color: #777777;
}

.collapsible-promo {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 90;
  overflow: hidden;
  background: #ffffff;
  will-change: height, opacity, transform;
}

.promo-scroll {
  width: 100%;
  height: 392rpx;
  padding: 24rpx 28rpx;
  white-space: nowrap;
}

.promo-card {
  display: inline-block;
  width: 282rpx;
  height: 344rpx;
  margin-right: 18rpx;
  overflow: hidden;
  border-radius: 10rpx;
  background: #f0f0f0;
}

.promo-card image {
  width: 100%;
  height: 100%;
}

.sticky-venue-filter {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 100;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(24, 35, 45, 0.04);
}

.quick-row {
  justify-content: space-between;
  padding: 18rpx 32rpx 18rpx;
  color: #363636;
  font-size: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.quick-item {
  display: flex;
  align-items: center;
  min-width: 0;
  line-height: 42rpx;
}

.quick-item.muted {
  color: #777777;
}

.quick-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin-right: 8rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 34rpx;
  border-radius: 8rpx;
}

.quick-icon-discount {
  background: linear-gradient(145deg, #ff7352 0%, #f04f2f 100%);
}

.quick-icon-coupon {
  background: linear-gradient(145deg, #ffc83d 0%, #f6a900 100%);
}

.date-panel,
.sport-panel,
.legend,
.venue-list {
  background: #ffffff;
}

.date-panel {
  margin-top: 0;
  padding: 24rpx 28rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.date-scroll,
.sport-scroll {
  white-space: nowrap;
}

.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 126rpx;
  height: 116rpx;
  margin-right: 32rpx;
  color: #20242a;
  border-radius: 10rpx;
}

.date-num {
  font-size: 32rpx;
  line-height: 42rpx;
}

.date-day {
  margin-top: 10rpx;
  font-size: 26rpx;
}

.date-item.active {
  color: #ffffff;
  background: linear-gradient(145deg, #ef2f8f 0%, #a538f0 100%);
}

.sport-panel {
  margin-top: 0;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.sport-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  margin-right: 18rpx;
  padding: 0 36rpx;
  color: #333333;
  font-size: 30rpx;
  border: 2rpx solid #eeeeee;
  border-radius: 36rpx;
  background: #ffffff;
}

.sport-item.active {
  color: #ffffff;
  border-color: transparent;
  background: linear-gradient(145deg, #ef2f8f 0%, #a538f0 100%);
}

.legend {
  display: flex;
  gap: 24rpx;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 0;
  padding: 20rpx 28rpx;
  color: #777777;
  font-size: 24rpx;
}

.legend-mark {
  display: inline-block;
  width: 28rpx;
  height: 8rpx;
  margin-right: 12rpx;
  vertical-align: middle;
  border-radius: 6rpx;
}

.legend-mark.using {
  background: #12a86b;
}

.legend-mark.booked {
  background: #b527e5;
}

.legend-mark.free {
  background: #e6e6e6;
}

.venue-list {
  padding: 0 0 150rpx;
}

.open-content-spacer {
  height: 0;
  background: #f6f6f6;
}

.venue-card {
  padding: 32rpx 28rpx 26rpx;
  border-top: 12rpx solid #f6f6f6;
  background: #ffffff;
}

.venue-content {
  display: flex;
  align-items: flex-start;
}

.venue-img {
  flex: 0 0 auto;
  width: 158rpx;
  height: 158rpx;
  margin-right: 20rpx;
  border-radius: 12rpx;
  background: linear-gradient(145deg, #ef2f8f 0%, #7c45ec 100%);
}

.venue-info {
  flex: 1;
  min-width: 0;
}

.venue-top {
  justify-content: space-between;
  min-width: 0;
}

.venue-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #1f1f1f;
  font-size: 34rpx;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.venue-state {
  flex: 0 0 auto;
  margin-left: 12rpx;
  color: #f0478b;
  font-size: 22rpx;
}

.venue-state.using {
  color: #12a86b;
}

.venue-state.booked {
  color: #a538f0;
}

.venue-state.disabled {
  color: #9a9a9a;
}

.tag-row {
  height: 38rpx;
  margin-top: 14rpx;
  overflow: hidden;
  white-space: nowrap;
}

.venue-tag {
  display: inline-flex;
  align-items: center;
  height: 34rpx;
  margin-right: 8rpx;
  padding: 0 10rpx;
  color: #9a875e;
  font-size: 22rpx;
  border: 1rpx solid #cdbd8b;
  background: #fffdf5;
}

.venue-tag.dark {
  color: #ffffff;
  border-color: #595959;
  background: #4a4a4a;
}

.venue-desc {
  display: block;
  width: 100%;
  margin-top: 10rpx;
  overflow: hidden;
  color: #777777;
  font-size: 24rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price-row {
  min-width: 0;
  margin-top: 14rpx;
  color: #777777;
  font-size: 22rpx;
  align-items: flex-end;
  line-height: 1;
}

.price-label {
  flex: 0 0 auto;
  padding-bottom: 4rpx;
}

.price-now {
  margin-left: 6rpx;
  color: #222222;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.price-origin {
  min-width: 0;
  margin-left: 10rpx;
  padding-bottom: 4rpx;
  overflow: hidden;
  color: #999999;
  text-decoration: line-through;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-row {
  display: flex;
  align-items: center;
  min-height: 54rpx;
  margin-top: 10rpx;
  padding: 0 8rpx 0 16rpx;
  color: #6d5528;
  font-size: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(90deg, #fff8e8 0%, #fff1cf 100%);
}

.member-price {
  flex: 1;
  min-width: 0;
  margin-left: 6rpx;
  color: #bc3429;
  font-size: 34rpx;
  font-weight: 800;
}

.spec-btn {
  flex: 0 0 auto;
  min-width: 76rpx;
  max-width: 96rpx;
  height: 34rpx;
  margin-left: 8rpx;
  padding: 0 10rpx;
  overflow: hidden;
  color: #4a3000;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
  text-overflow: clip;
  white-space: nowrap;
  border-radius: 18rpx;
  background: #f4c85d;
}

.spec-btn.disabled {
  color: #9a8a6a;
  background: #eadfbd;
}

.slot-strip {
  display: flex;
  gap: 16rpx;
  width: 100%;
  margin-top: 22rpx;
}

.slot {
  flex: 1;
  min-width: 26rpx;
}

.slot-bar {
  position: relative;
  height: 8rpx;
  overflow: hidden;
  border-radius: 6rpx;
  background: #e9e9e9;
}

.slot-segment {
  position: absolute;
  top: 0;
  bottom: 0;
}

.slot-segment.free {
  background: #e9e9e9;
}

.slot-segment.using {
  background: #12a86b;
}

.slot-segment.booked {
  background: #b527e5;
}

.slot-text {
  display: block;
  margin-top: 8rpx;
  color: #c6c6c6;
  font-size: 20rpx;
  text-align: center;
}

.cart-float {
  position: fixed;
  right: 28rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 10;
  min-width: 112rpx;
  height: 58rpx;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 58rpx;
  text-align: center;
  border-radius: 32rpx;
  background: rgba(63, 63, 63, 0.9);
}

.cart-badge {
  position: absolute;
  top: -18rpx;
  right: -12rpx;
  min-width: 34rpx;
  height: 34rpx;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 18rpx;
  background: #ef2f8f;
}

.cart-summary-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: 22rpx;
  z-index: 240;
  display: flex;
  align-items: center;
  height: 124rpx;
  overflow: hidden;
  border-radius: 66rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(20, 24, 30, 0.16);
}

.cart-summary-bar.panel-open {
  bottom: 26rpx;
  box-shadow: 0 16rpx 46rpx rgba(20, 24, 30, 0.18);
}

.cart-summary-main {
  display: flex;
  flex: 1 1 0;
  align-items: center;
  min-width: 0;
  width: 0;
  height: 100%;
  padding: 0 12rpx 0 22rpx;
}

.cart-summary-icon {
  position: relative;
  flex: 0 0 auto;
  width: 112rpx;
  height: 112rpx;
  margin-right: 18rpx;
}

.cart-summary-icon-img {
  width: 100%;
  height: 100%;
}

.cart-summary-badge {
  position: absolute;
  top: 12rpx;
  right: 16rpx;
  min-width: 34rpx;
  height: 34rpx;
  color: #7b5a14;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
  border-radius: 18rpx;
  background: #f2d577;
}

.cart-summary-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.cart-summary-line {
  display: flex;
  align-items: baseline;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  line-height: 1;
  white-space: nowrap;
}

.cart-summary-label {
  flex: 0 0 auto;
  color: #1e2228;
  font-size: 26rpx;
  font-weight: 400;
}

.cart-summary-total {
  flex: 0 0 auto;
  color: #1e2228;
  font-size: 42rpx;
  font-weight: 400;
}

.cart-summary-origin {
  flex: 0 1 auto;
  min-width: 0;
  margin-left: 8rpx;
  overflow: hidden;
  color: #a2a2a2;
  font-size: 26rpx;
  text-decoration: line-through;
  text-overflow: clip;
  white-space: nowrap;
}

.cart-summary-discount {
  display: inline-flex;
  align-items: center;
  flex: 0 0 auto;
  margin-left: 10rpx;
  color: #c63730;
  font-size: 24rpx;
  line-height: 30rpx;
  white-space: nowrap;
}

.cart-summary-arrow {
  width: 14rpx;
  height: 14rpx;
  margin-left: 8rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: translateY(-3rpx) rotate(45deg);
}

.cart-summary-arrow.open {
  transform: translateY(4rpx) rotate(225deg);
}

.cart-summary-checkout {
  flex: 0 0 196rpx;
  align-self: stretch;
  width: 196rpx;
  min-width: 196rpx;
  max-width: 196rpx;
  color: #f7d88a;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 124rpx;
  text-align: center;
  border-radius: 0 66rpx 66rpx 0;
  background: #3f3f3f;
}

.cart-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.58);
}

.cart-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 114rpx;
  z-index: 220;
  max-height: 58vh;
  padding: 34rpx 32rpx 42rpx;
  overflow-y: auto;
  border-radius: 38rpx 38rpx 0 0;
  background: #ffffff;
}

.cart-sheet-items {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 220;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  height: auto;
  max-height: 70vh;
  padding: 28rpx 0 150rpx;
  overflow: hidden;
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff;
}

.cart-items-head,
.cart-items-title,
.cart-item-card,
.discount-title,
.discount-row,
.discount-rule {
  display: flex;
  align-items: center;
}

.cart-items-head,
.discount-title {
  justify-content: space-between;
}

.cart-items-head {
  position: relative;
  flex: 0 0 auto;
  height: 76rpx;
  margin-bottom: 26rpx;
  padding: 0 104rpx 0 32rpx;
}

.cart-items-title {
  gap: 20rpx;
  flex: 1;
  min-width: 0;
  color: #1f242b;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 54rpx;
  white-space: nowrap;
}

.cart-items-title-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-items-check {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  color: #8c6e25;
  font-size: 25rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #f5d884;
}

.sheet-clear,
.discount-close {
  width: 58rpx;
  height: 58rpx;
  color: #555555;
  font-size: 34rpx;
  line-height: 58rpx;
  border-radius: 50%;
  background: #f5f5f5;
}

.cart-items-trash {
  position: absolute;
  top: 8rpx;
  right: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 60rpx !important;
  height: 60rpx;
  margin: 0;
  padding: 0;
  line-height: 1;
  background: transparent;
}

.cart-items-trash::after,
.cart-summary-checkout::after {
  border: 0;
}

.cart-items-trash image {
  width: 56rpx;
  height: 56rpx;
}

.cart-items-scroll {
  flex: 0 1 auto;
  height: auto;
  max-height: calc(70vh - 292rpx);
  padding: 0 32rpx 0rpx;
}

.cart-item-card {
  min-height: 174rpx;
  margin-bottom: 24rpx;
}

.cart-item-check {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  margin-right: 24rpx;
  color: transparent;
  font-size: 25rpx;
  line-height: 44rpx;
  text-align: center;
  border: 2rpx solid #e4e4e4;
  border-radius: 50%;
  background: #ffffff;
}

.cart-item-check.checked {
  color: #8c6e25;
  border-color: #f5d884;
  background: #f5d884;
}

.cart-item-img {
  flex: 0 0 auto;
  width: 174rpx;
  height: 174rpx;
  margin-right: 36rpx;
  border-radius: 8rpx;
  background: #f2f2f2;
}

.cart-item-main {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex: 1;
  min-width: 0;
  min-height: 174rpx;
  padding: 2rpx 0 0;
}

.cart-item-copy {
  min-width: 0;
}

.cart-item-name {
  display: block;
  max-width: 100%;
  overflow: hidden;
  color: #1f242b;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 52rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-item-sub {
  display: block;
  margin-top: 14rpx;
  overflow: hidden;
  color: #8e8e8e;
  font-size: 29rpx;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-item-foot {
  display: flex;
  align-items: baseline;
  justify-content: flex-start;
  min-height: 52rpx;
}

.cart-item-currency {
  color: #1f242b;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 52rpx;
}

.cart-item-price {
  display: block;
  color: #1f242b;
  font-size: 42rpx;
  font-weight: 500;
  line-height: 52rpx;
}

.discount-sheet {
  bottom: 0;
  max-height: none;
  padding: 44rpx 30rpx 142rpx;
  overflow: visible;
  border-radius: 36rpx 36rpx 0 0;
}

.discount-heading {
  position: absolute;
  left: 150rpx;
  right: 150rpx;
  top: 0;
  color: #20242a;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 62rpx;
  text-align: center;
}

.discount-title {
  position: relative;
  justify-content: center;
  min-height: 62rpx;
  margin-bottom: 30rpx;
  padding: 0;
}

.discount-close {
  position: absolute;
  right: 30rpx;
  top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  color: #565656;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
  border-radius: 18rpx;
  background: #f4f4f4;
}

.discount-row {
  justify-content: space-between;
  min-height: 72rpx;
  color: #20242a;
  font-size: 34rpx;
}

.discount-summary {
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 0 26rpx;
  font-size: 34rpx;
}

.discount-summary text:last-child {
  font-size: 38rpx;
}

.discount-box {
  margin-top: 0;
  padding: 22rpx 26rpx 22rpx;
  border-radius: 18rpx;
  background: #f5f5f5;
}

.discount-money {
  color: #c33b32;
}

.discount-label {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.discount-note {
  margin-left: 12rpx;
  color: #9a9a9a;
  font-size: 24rpx;
}

.discount-rule {
  justify-content: space-between;
  gap: 14rpx;
  min-height: 58rpx;
  color: #8a8a8a;
  font-size: 28rpx;
}

.discount-rule-text {
  display: flex;
  align-items: center;
  min-width: 0;
}

.rule-tag {
  flex: 0 0 auto;
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  color: #d34742;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 10rpx;
  background: #fff0ef;
}
